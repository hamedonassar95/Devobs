# This repository has no local application runtime configuration and does not
# load .env files. These are optional GitHub Actions secret names for reference.
# Configure them in GitHub Settings > Secrets and variables > Actions > Secrets.
# Never put real values in this file.
#
# COPILOT_GITHUB_TOKEN=
# GH_AW_CI_TRIGGER_TOKEN=
# GH_AW_GITHUB_TOKEN=
# GH_AW_GITHUB_MCP_SERVER_TOKEN=
# GH_AW_DEFAULT_OTLP_HEADERS=
#
# GITHUB_TOKEN is supplied automatically by GitHub Actions; do not add it here.
