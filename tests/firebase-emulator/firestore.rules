rules_version = '2';

// Experimental test fixture only. Never publish this policy.
// Production keeps apps/ai-intelligence-console/firestore.rules deny-all.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validOwnerRecord(data) {
      return signedIn()
        && data.keys().hasAll(['tenantId', 'ownerUid', 'name'])
        && data.keys().hasOnly(['tenantId', 'ownerUid', 'name'])
        && data.tenantId is string
        && data.tenantId == request.auth.token.tenant_id
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.name is string;
    }

    function ownsExistingRecord() {
      return signedIn()
        && resource.data.tenantId == request.auth.token.tenant_id
        && resource.data.ownerUid == request.auth.uid;
    }

    match /servers/{serverId} {
      allow get, list: if ownsExistingRecord();
      allow create: if validOwnerRecord(request.resource.data);
      allow update: if ownsExistingRecord()
        && validOwnerRecord(request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingRecord();
    }

    match /incidents/{incidentId} {
      allow get, list: if ownsExistingRecord();
      allow create: if validOwnerRecord(request.resource.data);
      allow update: if ownsExistingRecord()
        && validOwnerRecord(request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingRecord();
    }

    match /deployments/{deploymentId} {
      allow get, list: if ownsExistingRecord();
      allow create: if validOwnerRecord(request.resource.data);
      allow update: if ownsExistingRecord()
        && validOwnerRecord(request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingRecord();
    }
  }
}
