# External integrations stay disabled unless explicitly enabled.
VITE_FIREBASE_ENABLED=false
VITE_GOOGLE_WORKSPACE_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# Optional Gemini API access; usage may incur charges. Leave blank for offline fallbacks.
GEMINI_API_KEY=

# Local development defaults. The server binds to loopback unless HOST is explicitly changed.
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
